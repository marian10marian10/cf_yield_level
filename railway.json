{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "pip install -r requirements.txt"
    },
    "deploy": {
        "startCommand": "streamlit run yield_analysis_app_exata.py --server.port $PORT",
        "healthcheckPath": "/",
        "healthcheckTimeout": 100
    },
    "env": {
        "PYTHON_VERSION": "3.11"
    }
}